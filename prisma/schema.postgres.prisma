// =============================================================================
// SignalSieve — Production Prisma ORM Schema for Neon Serverless PostgreSQL
// Features: Connection pooling, SSL mode, optimized indexes
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClusteringConfig {
  id                      Int      @id @default(1)
  time_window_minutes     Int      @default(15)
  entity_weight           Float    @default(0.45)
  service_topology_weight Float    @default(0.30)
  text_similarity_weight  Float    @default(0.25)
  similarity_threshold    Float    @default(0.42)
  llm_provider            String   @default("deterministic")
  llm_api_key             String   @default("")
  llm_model               String   @default("gpt-4o-mini")
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("clustering_config")
}

model Cluster {
  id                    String     @id
  title                 String
  context_summary       String
  root_cause_hypothesis String
  recommended_action    String
  summary_source        String     @default("deterministic")
  status                String     @default("open")
  urgency_score         Float      @default(50)
  blast_radius_score    Float      @default(50)
  ranking_breakdown     Json       @default("{}") @db.JsonB
  dependency_graph      Json       @default("{\"nodes\":[],\"edges\":[]}") @db.JsonB
  alert_count           Int        @default(1)
  sources               Json       @default("[]") @db.JsonB
  services              Json       @default("[]") @db.JsonB
  entities              Json       @default("[]") @db.JsonB
  highest_severity      String
  environment           String
  first_seen            DateTime   @default(now()) @db.Timestamptz(6)
  last_seen             DateTime   @default(now()) @db.Timestamptz(6)
  pattern_signature     String

  alerts                RawAlert[]

  @@index([status, urgency_score(sort: Desc), blast_radius_score(sort: Desc), last_seen(sort: Desc)], map: "idx_clusters_triage_priority")
  @@index([last_seen(sort: Desc), pattern_signature], map: "idx_clusters_window_sig")
  @@map("clusters")
}

model SuppressionRule {
  id                String     @id
  name              String
  pattern_signature String
  match_criteria    Json       @default("{}") @db.JsonB
  reason            String
  created_by        String
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  expires_at        DateTime   @db.Timestamptz(6)
  is_active         Boolean    @default(true)
  suppressed_count  Int        @default(0)

  alerts            RawAlert[]

  @@index([pattern_signature, expires_at(sort: Desc)], map: "idx_suppression_rules_sig_exp")
  @@index([match_criteria(ops: JsonbPathOps)], type: Gin, map: "idx_suppression_rules_criteria_gin")
  @@map("suppression_rules")
}

model RawAlert {
  id                  String           @id
  source              String
  external_id         String
  timestamp           DateTime         @default(now()) @db.Timestamptz(6)
  ingested_at         DateTime         @default(now()) @db.Timestamptz(6)
  title               String
  description         String
  severity            String
  service             String
  environment         String
  host                String
  entity_tags         Json             @default("{}") @db.JsonB
  fingerprint         String
  cluster_id          String?
  suppressed          Boolean          @default(false)
  suppression_rule_id String?
  raw_payload         Json             @default("{}") @db.JsonB

  cluster             Cluster?         @relation(fields: [cluster_id], references: [id], onDelete: SetNull)
  suppression_rule    SuppressionRule? @relation(fields: [suppression_rule_id], references: [id], onDelete: SetNull)

  @@index([entity_tags(ops: JsonbPathOps)], type: Gin, map: "idx_raw_alerts_entity_tags_gin")
  @@index([cluster_id, timestamp(sort: Desc)], map: "idx_raw_alerts_cluster_timeline")
  @@index([service, fingerprint, timestamp(sort: Desc)], map: "idx_raw_alerts_service_fingerprint")
  @@map("raw_alerts")
}
