{
  "name": "tct-signalsieve",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./scripts/db.mjs generate && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typegen": "node ./node_modules/next/dist/bin/next typegen",
    "analyze": "node ./node_modules/next/dist/bin/next analyze",
    "db:generate": "node ./scripts/db.mjs generate",
    "db:push": "node ./scripts/db.mjs push",
    "db:studio": "node ./scripts/db.mjs studio",
    "db:use:sqlite": "node ./scripts/db.mjs use:sqlite",
    "db:use:neon": "node ./scripts/db.mjs use:neon",
    "prisma:generate": "node ./scripts/db.mjs generate",
    "prisma:push": "node ./scripts/db.mjs push",
    "prisma:studio": "node ./scripts/db.mjs studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
