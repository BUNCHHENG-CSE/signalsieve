# =============================================================================
# TCT SignalSieve — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Local Development (Zero-Config SQLite — Default):
DATABASE_URL="file:./data/signalsieve.db"

# Production / Cloud (Neon Serverless PostgreSQL):
# Pooled connection string (Recommended for Next.js / Serverless):
# DATABASE_URL="postgresql://user:password@ep-cool-snowflake-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Direct connection string:
# DATABASE_URL="postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# PostgreSQL Connection Pool Tuning (Neon / Postgres)
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PG_SSL=true

# -----------------------------------------------------------------------------
# 2. OPTIONAL LLM SUMMARY SYNTHESIS (Settings can also be set in Dashboard UI)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""
